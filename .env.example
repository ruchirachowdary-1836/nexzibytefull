DB_URL=sqlite:///./techtalk.db
# Neon PostgreSQL example:
# DB_URL=postgresql://user:password@your-neon-host/neondb?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Use the exact browser origins that call the API. Do not include a path or
# trailing slash. Comma-separate local and production origins when needed.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://techtalk-frontend-acvb.onrender.com

# Frontend-only variable. This must be the same OAuth 2.0 Web client ID as
# GOOGLE_CLIENT_ID. Configure its authorized JavaScript origins in Google
# Cloud Console before enabling the Google button.
# VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
