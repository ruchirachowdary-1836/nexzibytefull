DB_URL=sqlite:///./techtalk.db
# Neon PostgreSQL example:
# DB_URL=postgresql://user:password@your-neon-host/neondb?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
PASS_QR_SECRET=replace-with-a-separate-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Use the exact browser origins that call the API. Do not include a path or
# trailing slash. Comma-separate local and production origins when needed.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://techtalk-frontend-acvb.onrender.com
# Background maintenance cadence and retention for unverified accounts.
CLEANUP_INTERVAL_SECONDS=3600
STALE_ACCOUNT_DAYS=30
VITE_NEON_AUTH_CALLBACK_URL=https://techtalk-frontend-acvb.onrender.com/
# Optional SMTP settings for verification-code delivery.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
MAIL_FROM=TechTalk <no-reply@example.com>
